#!/bin/bash
# (se relance automatiquement dans l'environnement Simu5G si nécessaire)
if [ -z "$SIMU5G_ROOT" ]; then exec ~/bin/tp-env "$(cd "$(dirname "$0")" && pwd)/$(basename "$0") $*"; fi
# tp-run <Config> [runs] [options opp]  — lance une config Simu5G (Cmdenv) depuis le dossier courant
# Exemples :  tp-run SingleCell-DL        tp-run SingleCell-DL 0..4
set -e
CONFIG=${1:?"usage: tp-run <Config> [runs]"}
RUNS=${2:-0}
shift; [ $# -gt 0 ] && shift
[ -f omnetpp.ini ] || { echo "Pas de omnetpp.ini dans $(pwd)"; exit 1; }
echo ">> Config=$CONFIG  runs=$RUNS"
opp_runall -j"$(nproc)" simu5g -u Cmdenv -c "$CONFIG" -r "$RUNS" \
    --cmdenv-express-mode=true --cmdenv-status-frequency=5s "$@"
