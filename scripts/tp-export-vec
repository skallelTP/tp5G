#!/bin/bash
# (se relance automatiquement dans l'environnement Simu5G si nécessaire)
if [ -z "$SIMU5G_ROOT" ]; then exec ~/bin/tp-env "$(cd "$(dirname "$0")" && pwd)/$(basename "$0") $*"; fi
# tp-export-vec <nom> [results_dir] [out.csv] — exporte des vecteurs (ex: voIPFrameDelay:vector)
NAME=${1:?"usage: tp-export-vec <name> [results_dir] [out.csv]"}
DIR=${2:-results}
OUT=${3:-vectors.csv}
find "$DIR" -name '*.vec' -print0 | xargs -0 opp_scavetool export -f "type =~ vector AND name =~ \"$NAME\"" -F CSV-R -o "$OUT"
echo ">> $OUT écrit"
